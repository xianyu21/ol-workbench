{
  "name": "axhub-desktop",
  "version": "1.0.9",
  "description": "AxHub 原型工作台 · 桌面端（Electron 壳，复用本地 HTTP 服务 axhub-server.js + axhub-viewer.html）",
  "main": "main.js",
  "author": "AxHub Viewer",
  "license": "MIT",
  "scripts": {
    "build:viewer": "cd viewer && npm run build",
    "start": "npm run build:viewer && electron .",
    "pack": "npm run build:viewer && electron-builder --dir",
    "dist": "npm run build:viewer && electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.axhub.viewer.desktop",
    "productName": "AxHub 原型工作台",
    "files": [
      "main.js",
      "preload.js",
      "picker.html"
    ],
    "extraResources": [
      {
        "from": "axhub-server.js",
        "to": "axhub-server.js"
      },
      {
        "from": "viewer-dist",
        "to": "viewer-dist"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xianyu21",
        "repo": "ol-workbench"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
