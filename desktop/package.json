{
  "name": "axhub-desktop",
  "version": "1.0.26",
  "description": "AxHub 原型工作台 · 桌面端（Electron 壳，serve-core 挂 axhub:// 协议，零端口零依赖）",
  "main": "main.js",
  "author": "AxHub Viewer",
  "license": "MIT",
  "scripts": {
    "build:viewer": "cd viewer && npm run build",
    "start": "npm run build:viewer && electron .",
    "test": "node --test",
    "pack": "npm run build:viewer && electron-builder --dir",
    "dist": "npm run build:viewer && electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.axhub.viewer.desktop",
    "productName": "AxHub 原型工作台",
    "files": [
      "main.js",
      "preload.js",
      "picker.html",
      "user-store.js",
      "user-keys.js",
      "serve-core.js",
      "scan-shared.js"
    ],
    "extraResources": [
      {
        "from": "viewer-dist",
        "to": "viewer-dist"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "artifactName": "AxHub-Setup-${version}.${ext}" },
        { "target": "portable", "artifactName": "AxHub-Portable-${version}.${ext}" }
      ],
      "signAndEditExecutable": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xianyu21",
        "repo": "ol-workbench"
      }
    ],
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
