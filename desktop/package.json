{
  "name": "axhub-desktop",
  "version": "1.4.0",
  "description": "AxHub 原型工作台 · 桌面端（Electron 壳，serve-core 挂 axhub:// 协议，零端口零依赖）",
  "main": "main.js",
  "author": "AxHub Viewer",
  "license": "MIT",
  "workspaces": [
    "viewer"
  ],
  "scripts": {
    "build:viewer": "npm run build --workspace viewer",
    "start": "npm run build:viewer && electron .",
    "pack": "npm run build:viewer && electron-builder --dir",
    "dist": "npm run build:viewer && node scripts/dist-safe.mjs",
    "dist:safe": "node scripts/dist-safe.mjs",
    "test": "node --test",
    "type-check": "npm run type-check --workspace viewer",
    "version": "node scripts/bump-version.mjs",
    "release:check": "node scripts/release-check.mjs",
    "lint": "eslint src preload.js",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.0.0",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.0.0"
  },
  "build": {
    "appId": "com.axhub.viewer.desktop",
    "productName": "AxHub 原型工作台",
    "files": [
      "main.js",
      "preload.js",
      "picker.html",
      "user-store.js",
      "user-keys.js",
      "serve-core.js",
      "scan-shared.js",
      "src/**/*",
      "!src/**/__tests__/**"
    ],
    "extraResources": [
      {
        "from": "viewer-dist",
        "to": "viewer-dist"
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "AxHub-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AxHub-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xianyu21",
        "repo": "ol-workbench"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "AxHub-mac-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
